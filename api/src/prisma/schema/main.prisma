generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "inventory", "orders", "public"]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Cart {
  id        Int        @id @default(autoincrement())
  ownerId   String
  orders    Orders[]
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@schema("public")
}

model Inventory {
  id        Int             @id @default(autoincrement())
  name      String          @db.VarChar(50)
  quantity  Int
  status    InventoryStatus @default(Available)
  productId Int             @unique
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@schema("inventory")
}

model Orders {
  id           Int           @id @default(autoincrement())
  payment      PaymentMethod @default(Cash)
  cartId       Int
  checkoutTime DateTime      @default(now())
  status       OrderStatus
  cart         Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@schema("orders")
}

model Product {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(50)
  size      Sizes
  price     Int
  inventory Inventory?
  cartItems CartItem[]

  @@schema("public")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@schema("auth")
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique @db.VarChar(254)
  role               Role               @default(Member)
  created_at         DateTime           @default(now())
  isVerified         Boolean            @default(false)
  updated_at         DateTime           @updatedAt
  refreshToken       RefreshToken?
  credentials        UserCredentials[]
  profile            UserProfile?
  verificationTokens VerificationToken?
  carts              Cart[]

  @@schema("auth")
}

model UserCredentials {
  id           String    @id @default(uuid())
  provider     Providers
  providerId   String?
  passwordHash String?   @db.VarChar(72)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@schema("auth")
}

model UserProfile {
  firstName      String  @db.VarChar(50)
  lastName       String  @db.VarChar(100)
  username       String? @unique @db.VarChar(30)
  userId         String  @id
  profilePicture String? @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

enum InventoryStatus {
  Available
  Low_On_stock
  Not_Available
  For_Delivery

  @@schema("inventory")
}

enum OrderStatus {
  Confirming_Order
  Preparing
  Ready_For_Pickup
  For_Delivery
  Done
  Cancelled

  @@schema("orders")
}

enum Providers {
  Local
  Facebook
  Google

  @@schema("auth")
}

enum PaymentMethod {
  Cash
  E_Wallet
  Debit_Or_Credit

  @@schema("orders")
}

enum Role {
  Member
  Guest
  Admin

  @@schema("auth")
}

enum Sizes {
  Small
  Medium
  Large
  Solo
  For_Share

  @@schema("inventory")
}
